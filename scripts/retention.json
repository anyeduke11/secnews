{
  "$schema": "v0.5 M2-T6 全站表生命周期台账",
  "$purpose": "single-source-of-truth: 每张表 → 温度层 / 物理 db / retention / action / 关联 job。db_diet.py + migrate_temp_layers.py + check_backup_chain.py 全部读取此台账。",
  "$temp_layers": {
    "HOT": {
      "db": "hotspot.db",
      "encrypted": false,
      "backup": "incremental_daily + full_sunday"
    },
    "WARM": {
      "db": "hotspot-warm.db",
      "encrypted": false,
      "backup": "weekly_incremental"
    },
    "COLD": {
      "db": "hotspot-cold.db",
      "encrypted": true,
      "backup": "weekly_full"
    },
    "FROZEN": {
      "db": "knowledge/ + llm-wiki-2.0/",
      "encrypted": false,
      "backup": "weekly_zip_incremental"
    }
  },
  "$retention_keys_legend": {
    "table": "SQLite 表名",
    "temp": "HOT | WARM | COLD | FROZEN",
    "ts_column": "时间戳列 (iso)",
    "retention_days": "保留 N 天, 之外 truncate/archive/keep",
    "action": "truncate | archive_db_table | archive_jsonl | keep",
    "source": "telemetry | index | event | state (数据来源定性: 流水/派生可重建/事件审计/业务状态)",
    "scheduled_in": "telemetry_window | weekly_maintenance | backup | inline | none",
    "notes": "补充说明"
  },
