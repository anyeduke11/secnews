# SecNews 配置文件模板 (v0.7.0)
# ===============================================================
# 复制本文件为 .env 并填入真实值，.env 已在 .gitignore 中被排除
# 不会被推送到 GitHub。所有变量以前缀 HOTSPOT_ 读取 (Pydantic Settings)
# ===============================================================

# --- Server（默认 127.0.0.1，0.0.0.0 会把无认证 API 暴露给整个局域网） ---
HOTSPOT_HOST=127.0.0.1
HOTSPOT_PORT=8000

# --- Logging ---
HOTSPOT_LOG_LEVEL=INFO

# --- Quality gates ---
HOTSPOT_QUALITY_STRICT_MODE=false
HOTSPOT_QUALITY_MIN_SCORE=50

# --- Proxy（也可由前端 /secnews/settings 运行时改） ---
# 后端启动时会读 backend/proxy_config.json；本节是默认覆盖
HOTSPOT_PROXY_MODE=off
# HOTSPOT_PROXY_MODE=manual
# HOTSPOT_HTTP_PROXY=http://127.0.0.1:7897
# HOTSPOT_HTTPS_PROXY=http://127.0.0.1:7897

# --- Feature gates（默认开启已稳定功能；env 覆盖优先级高于 backend/config/feature_gates.toml） ---
# HOTSPOT_FEATURE_GATES={"extensions": {"codegarden": true, "mcp": true, "secnews": true}}

# --- COLD DB 加密（v0.5 M2-T6，dev 留空 = 不加密） ---
# HOTSPOT_COLD_DB_KEY=

# --- LLM Wiki v2 真源路径（v0.5+ 默认 llm-wiki-2.0/） ---
# HOTSPOT_LLM_WIKI_V2=true
# HOTSPOT_LLM_WIKI_V2_PATH=/absolute/path/to/llm-wiki-2.0

# --- LLM API Keys（可选，ai_hub/ 会通过环境变量读取） ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...
# DASHSCOPE_API_KEY=...
