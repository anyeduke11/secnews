# hotspot 环境变量示例 — 复制为 .env 后按需修改
# 后端配置 (env 前缀 HOTSPOT_)
HOTSPOT_HOST=127.0.0.1
HOTSPOT_PORT=8000
HOTSPOT_LOG_LEVEL=INFO
# HOTSPOT_DB_PATH=backend/hotspot.db   # 默认 backend/hotspot.db
# HOTSPOT_CACHE_TTL_SECONDS=300

# 采集
HOTSPOT_COLLECT_INTERVAL_SECONDS=300
HOTSPOT_CATCHUP_ON_STARTUP=true

# 代理 (security/github 采集器需要; 也可在运行时前端设置页修改 backend/proxy_config.json)
# HOTSPOT_PROXY_MODE=auto

# 质量门禁
# HOTSPOT_QUALITY_STRICT_MODE=false
# HOTSPOT_QUALITY_MIN_SCORE=50

# 知识库
# HOTSPOT_LOCAL_WIKI_ENABLED=false
# HOTSPOT_KNOWLEDGE_WATCHDOG_ENABLED=true

# 功能开关 (默认值见 backend/config/__init__.py)
# HOTSPOT_FEATURE_REVIEWS=false
# HOTSPOT_FEATURE_ALERTS=false

# 可选爬虫引擎 (需先安装 backend/requirements-optional.txt)
# 开关/并发/超时统一在 backend/collectors/crawl_config.yaml 配置, 无 env 开关
